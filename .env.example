# Server
PORT=5174
HOST=127.0.0.1
CLIENT_ORIGIN=http://127.0.0.1:5173
CONTEXT_DIR=./context

# Gemini provider
# Preferred when set.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI provider
# Used only when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Web search
# Set to "gemini" to let Gemini use Google Search grounding.
# Set to "openai" to let the OpenAI provider use hosted web search when available.
# Leave as "none" for the MVP no-op search adapter.
SEARCH_PROVIDER=none
